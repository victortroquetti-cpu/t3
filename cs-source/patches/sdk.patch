+#ifdef TROK
+// Animação nova: eventos de tiro, recarga e pulo (do servidor pelo TE, ou da predição local).
+void C_HL2MP_Player::DoAnimationEvent( PlayerAnimEvent_t event, int nData )
+{
+	if ( IsLocalPlayer() && prediction->InPrediction() && !prediction->IsFirstTimePredicted() )
+		return;
+	MDLCACHE_CRITICAL_SECTION();
+	if ( m_pTrokAnimState )
+		m_pTrokAnimState->DoAnimationEvent( event, nData );
+}
+
+// No cliente, o código compartilhado das armas chama SetAnimation na predição do jogador local.
+void C_HL2MP_Player::SetAnimation( PLAYER_ANIM playerAnim )
+{
+	if ( !TrokAnimNova() )
+	{
+		BaseClass::SetAnimation( playerAnim );
+		return;
+	}
+	if ( playerAnim == PLAYER_ATTACK1 )
+		DoAnimationEvent( PLAYERANIMEVENT_ATTACK_PRIMARY );
+	else if ( playerAnim == PLAYER_RELOAD )
+		DoAnimationEvent( PLAYERANIMEVENT_RELOAD );
+	else if ( playerAnim == PLAYER_JUMP )
+		DoAnimationEvent( PLAYERANIMEVENT_JUMP );
+}
+#endif
