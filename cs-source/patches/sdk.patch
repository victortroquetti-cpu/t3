+#ifdef TROK
+//-----------------------------------------------------------------------------
+// Trok: fontes e cores do mod no chat do Source (o histórico que some, a rolagem e o
+// campo de texto com acento continuam os do CBaseHudChat). Cores em design/ui.md.
+//-----------------------------------------------------------------------------
+void CHudChat::TrokEstilo( void )
+{
+	vgui::HFont hFonte = TrokUI::Fonte( "ChatFont" );
+	if ( hFonte == vgui::INVALID_FONT )
+		return;
+	// Fundo do painel com a cor dos painéis do mod (o alfa continua com o FadeChatHistory).
+	SetBgColor( Color( 20, 23, 28, GetBgColor().a() ) );
+	// Histórico e campo de texto passam a usar o TrokScheme ("ChatFont" e as cores de
+	// RichText/TextEntry de lá), então a fonte do mod volta sozinha quando o esquema é reaplicado.
+	const vgui::HScheme hTrok = TrokUI::Esquema();
+	if ( GetChatHistory() )
+	{
+		if ( GetChatHistory()->GetScheme() != hTrok )
+			GetChatHistory()->SetScheme( hTrok );
+		GetChatHistory()->SetFont( hFonte );
+	}
+	if ( m_pChatInput && m_pChatInput->GetScheme() != hTrok )
+		m_pChatInput->SetScheme( hTrok );
+	if ( m_pChatInput )
+	{
+		vgui::Label *pPrompt = m_pChatInput->GetPrompt();
+		if ( pPrompt )
+		{
+			const vgui::HFont hPrompt = TrokUI::Fonte( "TrokChatPrompt" );
+			pPrompt->SetFont( hPrompt != vgui::INVALID_FONT ? hPrompt : hFonte );
+			pPrompt->SetFgColor( TrokUI::Destaque() );
+		}
+		vgui::TextEntry *pEntry = dynamic_cast< vgui::TextEntry * >( m_pChatInput->GetInputPanel() );
+		if ( pEntry )
+		{
+			pEntry->SetFont( hFonte );
+			pEntry->SetFgColor( TrokUI::COR_TEXTO );
+		}
+	}
+	// O botão de filtros do Source não existe no Trok.
+	if ( m_pFiltersButton )
+		m_pFiltersButton->SetVisible( false );
+}
+
+void CHudChat::StartMessageMode( int iMessageModeType )
+{
+	BaseClass::StartMessageMode( iMessageModeType );
+	// O CBaseHudChat volta a fonte do ClientScheme ao abrir: põe a do mod de novo.
+	TrokEstilo();
+	if ( m_pChatInput )
+	{
+		m_pChatInput->SetPrompt( iMessageModeType == MM_SAY_TEAM ? L"TIME:" : L"TODOS:" );
+		vgui::Label *pPrompt = m_pChatInput->GetPrompt();
+		if ( pPrompt )
+			pPrompt->SetFgColor( iMessageModeType == MM_SAY_TEAM ? TrokUI::COR_ALIADO : TrokUI::Destaque() );
+	}
+}
+
