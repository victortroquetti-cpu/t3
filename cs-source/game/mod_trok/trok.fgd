// Trok: entidades do mod para o Hammer. Em Hammer > Tools > Options > Game Configurations,
// adicione este arquivo junto do FGD do HL2MP (halflife2.fgd / hl2mp.fgd).

@include "hl2mp.fgd"

@PointClass base(Targetname) iconsprite("editor/logic_auto.vmt") = trok_surto_logica :
	"Modo Surto: saídas da rodada para o mapa (alarme, abrigos, vencedor)."
[
	output OnPreparo(void) : "Rodada nova: preparo (todos humanos)."
	output OnInicio(void) : "Infectados sorteados, relógio correndo."
	output OnAlarme(void) : "Hora do alarme (trok_surto_alarme)."
	output OnAbrigos(void) : "Abrigos abrem (trok_surto_abrigos). Ligue aqui as portas dos abrigos."
	output OnHumanosVencem(void) : "Humanos sobreviveram."
	output OnZumbisVencem(void) : "Infectados venceram."
]

@PointClass base(Targetname) size(-16 -16 0, 16 16 72) color(80 160 255) = info_trok_abrigo :
	"Modo Surto: centro de um abrigo. Os bots humanos vão para cá quando os abrigos abrem."
[
	raio(float) : "Raio do abrigo (u)" : 300 : "Dentro deste raio o bot está no abrigo e fecha a grade mais perto."
]

@SolidClass base(Targetname, RenderFields) = func_trok_grade :
	"Modo Surto: grade de abrigo. Humano aperta USAR para fechar/abrir; fechada é sólida e os " +
	"infectados quebram batendo. Aberta fica translúcida (mostra onde fecha)."
[
	vida(integer) : "Vida" : 1500 : "Dano de garra que aguenta fechada."
	tabuas(integer) : "Tábuas (Hordas)" : 6 : "Modo Hordas: a vida dividida em tábuas; cada E conserta uma (+10 pontos). Use 'Começa fechada' = Sim."
	inicio_fechada(choices) : "Começa fechada" : 0 =
	[
		0 : "Não"
		1 : "Sim"
	]
	liberar_nos_abrigos(choices) : "Só pode ser usada depois que os abrigos abrem" : 1 =
	[
		0 : "Não (sempre)"
		1 : "Sim"
	]

	input Liberar(void) : "Passa a poder ser fechada pelos humanos."
	input Fechar(void) : "Fecha (e libera)."
	input Abrir(void) : "Abre."

	output OnFechada(void) : "Foi fechada."
	output OnAberta(void) : "Foi aberta."
	output OnGolpe(void) : "Um infectado bateu nela."
	output OnQuebrada(void) : "Quebrou."
]

// ---------------------------------------------------------------------------
// Modo Hordas (design/modo-hordas.md). Estações são pincéis: desenhe a parede, a máquina,
// a porta ou a caixa com a textura que quiser e transforme em entidade. Usa-se com E.
// Barricada = func_trok_grade (acima) com "Começa fechada" Sim e "tabuas".
// ---------------------------------------------------------------------------

@PointClass base(Targetname) size(-16 -16 0, 16 16 72) color(200 60 60) = info_trok_hordas_spawn :
	"Modo Hordas: nascedouro de zumbi. Ponha fora da área dos jogadores, atrás de uma barricada " +
	"(func_trok_grade) ou numa saída de duto. O diretor usa os mais perto dos jogadores."
[
	area(integer) : "Área" : 0 : "0 = sempre (padrão). Outro número: só vale depois da entrada AbrirArea do trok_hordas_logica (ou de uma porta paga opcional)."
	chefe(choices) : "Lugar do chefe" : 0 =
	[
		0 : "Não"
		1 : "Sim (o Colosso nasce aqui; sem nenhum, nasce num normal)"
	]
	StartDisabled(choices) : "Começa desligado" : 0 =
	[
		0 : "Não"
		1 : "Sim"
	]
	input Ligar(void) : "Liga."
	input Desligar(void) : "Desliga."
]

@PointClass base(Targetname) iconsprite("editor/logic_auto.vmt") = trok_hordas_logica :
	"Modo Hordas: saídas das rodadas para o mapa e entradas para abrir áreas."
[
	output OnRodadaInicio(integer) : "Rodada começou (número da rodada)."
	output OnRodadaFim(integer) : "Rodada acabou (número da rodada)."
	output OnEnergia(void) : "A energia foi ligada."
	output OnChefe(integer) : "Rodada com chefe começou."
	output OnFimDeJogo(integer) : "Todos caíram (rodada alcançada)."
	output OnArea(integer) : "Uma área foi aberta (número)."
	input AbrirArea(integer) : "Abre a área N (liga os nascedouros dela)."
	input LigarEnergia(void) : "Liga a energia."
]

@BaseClass base(Targetname) = TrokHordasEstacao
[
	rotulo(string) : "Rótulo" : "" : "Nome no aviso (vazio = o nome da arma ou do tipo)."
	comeca_desligada(choices) : "Começa escondida" : 0 =
	[
		0 : "Não"
		1 : "Sim (some até a entrada Ligar)"
	]
	input Ligar(void) : "Aparece / volta a funcionar."
	input Desligar(void) : "Some."
	output OnUsada(void) : "Alguém comprou / abriu / ligou."
	output OnSemPontos(void) : "Alguém tentou sem pontos."
]

@SolidClass base(TrokHordasEstacao) = func_trok_compra_parede :
	"Modo Hordas (OPCIONAL, fora do desenho padrão: as armas se compram na func_trok_loja): arma na parede. E compra a arma; tendo, compra munição."
[
	arma(string) : "Arma" : "weapon_trok_submetralhadora" : "Classe da arma (weapon_trok_pistola, _submetralhadora, _fuzil, _escopeta...)."
	preco(integer) : "Preço" : 1000 : "Pontos."
	preco_municao(integer) : "Preço da munição" : 0 : "0 = metade do preço. Arma melhorada paga o da máquina (trok_upgrade.txt)."
	precisa_energia(choices) : "Precisa de energia" : 0 = [ 0 : "Não" 1 : "Sim" ]
]

@SolidClass base(TrokHordasEstacao) = func_trok_porta_paga :
	"Modo Hordas (OPCIONAL, fora do desenho padrão: o dono não quer portas pagas): porta que some quando alguém paga e abre uma área de nascedouros."
[
	preco(integer) : "Preço" : 1000 : "Pontos (CoD: 750 a 1500)."
	area(integer) : "Área que abre" : 2 : "Liga os info_trok_hordas_spawn com esta área. Portas com a mesma área abrem juntas."
	input Abrir(void) : "Abre sem pagar."
]

@SolidClass base(TrokHordasEstacao) = func_trok_maquina_upgrade :
	"Modo Hordas: máquina de melhoria. Arma de fogo na mão: MK I a MK V. Arma de defesa na mão (torreta, claymore, mina, remota): nível de defesa I a III do jogador (scripts/trok_upgrade.txt)."
[
	precisa_energia(choices) : "Precisa de energia" : 1 = [ 0 : "Não" 1 : "Sim" ]
]

@SolidClass base(TrokHordasEstacao) = func_trok_caixa_misteriosa :
	"Modo Hordas: caixa misteriosa. Paga, gira e oferece uma arma sorteada (scripts/trok_hordas.txt) só para quem pagou."
[
	preco(integer) : "Preço" : 0 : "0 = trok_hordas_caixa_preco (950)."
	precisa_energia(choices) : "Precisa de energia" : 0 = [ 0 : "Não" 1 : "Sim" ]
]

@SolidClass base(TrokHordasEstacao) = func_trok_bancada :
	"Modo Hordas (OPCIONAL: o padrão é a func_trok_loja): bancada de um item só."
[
	item(string) : "Item" : "weapon_trok_torreta" : "Arma de defesa (weapon_trok_torreta, _claymore, _mina, _remota), weapon_trok_granada, colete ou kit_reanimacao. Tendo a arma: repõe até o máximo (trok_max_*)."
	preco(integer) : "Preço" : 1500 : "Pontos."
	preco_municao(integer) : "Preço da reposição" : 0 : "0 = o mesmo preço."
	precisa_energia(choices) : "Precisa de energia" : 0 = [ 0 : "Não" 1 : "Sim" ]
]

@SolidClass base(TrokHordasEstacao) = func_trok_energia :
	"Modo Hordas: chave de energia. E liga (uma vez); as estações com 'Precisa de energia' passam a funcionar."
[
	input Abrir(void) : "Liga a energia."
]

@SolidClass base(TrokHordasEstacao) = func_trok_loja :
	"Modo Hordas: LOJA (o jeito padrão de comprar). E abre o menu com armas, munição, defesas (torreta, " +
	"claymore, mina, remota, granada) e equipamento (scripts/trok_hordas_loja.txt). Só compra quem está " +
	"perto (trok_hordas_loja_distancia). Uma ou poucas por mapa, num lugar que obrigue a andar."
[
	precisa_energia(choices) : "Precisa de energia" : 0 = [ 0 : "Não" 1 : "Sim" ]
]

@SolidClass base(TrokHordasEstacao) = func_trok_armadilha :
	"Modo Hordas: painel de armadilha (como as do CoD). E liga por 'preco' pontos durante 'duracao' s; " +
	"depois descansa 'recarga' s. Quem estiver na zona leva dano. Limite: trok_hordas_limite_armadilha por jogador."
[
	item(choices) : "Tipo" : "eletrica" =
	[
		"eletrica" : "Elétrica (mata zumbi na hora; fere humano)"
		"fogo" : "Fogo (400/s em zumbi)"
		"arame" : "Arame eletrificado (60/s e lentidão)"
	]
	zona(target_destination) : "Zona" : "" : "Nome do trigger_trok_armadilha (vazio = 160 u em volta do painel)."
	preco(integer) : "Preço" : 1000 : "Pontos (CoD: 1000)."
	duracao(float) : "Duração (s)" : 25 : "Tempo ligada."
	recarga(float) : "Recarga (s)" : 30 : "Tempo até poder ligar de novo."
	dano(float) : "Dano em zumbi por s" : -1 : "-1 = o do tipo."
	dano_humano(float) : "Dano em humano por s" : -1 : "-1 = o do tipo (0 = não fere)."
	lentidao(float) : "Lentidão" : -1 : "x velocidade do zumbi na zona (-1 = o do tipo; arame 0,35)."
	precisa_energia(choices) : "Precisa de energia" : 0 = [ 0 : "Não" 1 : "Sim" ]
]

@SolidClass base(Targetname) = trigger_trok_armadilha :
	"Modo Hordas: zona de uma func_trok_armadilha (pincel invisível, não sólido; use a textura trigger)."
[
]
